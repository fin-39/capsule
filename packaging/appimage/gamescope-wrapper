#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
appdir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
glibc_dir=$appdir/usr/lib/capsule/glibc
runtime=$appdir/usr/libexec/capsule/gamescope-runtime

# Gamescope and its bundled libraries come from the same build host. Start
# them with that host's matching glibc so a newer release AppImage also works
# on distributions whose system glibc is older.
exec "$glibc_dir/ld-linux-x86-64.so.2" \
    --library-path "$glibc_dir:$appdir/usr/lib:$appdir/usr/lib/systemd" \
    "$runtime" "$@"
