#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
appdir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
glibc_dir=$appdir/usr/lib/capsule/glibc
runtime=$appdir/usr/libexec/capsule/gamescopereaper-runtime

# Keep Gamescope's process supervisor on the same compatibility runtime as
# Gamescope itself. The helper is resolved through PATH by Gamescope.
exec "$glibc_dir/ld-linux-x86-64.so.2" \
    --library-path "$glibc_dir:$appdir/usr/lib:$appdir/usr/lib/systemd" \
    "$runtime" "$@"
